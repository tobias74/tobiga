RewriteEngine On
RewriteBase /

# Redirect non-canonical hosts to the canonical HTTPS root.
RewriteCond %{HTTP_HOST} !^tobiga\.com$ [NC]
RewriteRule ^ https://tobiga.com/ [R=301,L,QSD]

# Redirect HTTP requests to the canonical HTTPS root before applying the SPA fallback.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://tobiga.com/ [R=301,L,QSD]

# If the requested file or directory does not exist, serve index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
